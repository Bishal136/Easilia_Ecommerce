# Server Configuration
PORT=5000
NODE_ENV=development
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/nerob_ecommerce

# JWT Authentication
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_12345
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_12345
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# VPS Media / File Upload Configuration
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=100
MAX_DOC_SIZE_MB=25

# PortPos Payment Gateway
PORTPOS_STORE_ID=your_portpos_store_id
PORTPOS_STORE_PASSWORD=your_portpos_store_password
PORTPOS_IS_LIVE=false
PORTPOS_SUCCESS_URL=http://localhost:5173/payment/success
PORTPOS_FAIL_URL=http://localhost:5173/payment/fail
PORTPOS_CANCEL_URL=http://localhost:5173/payment/cancel
PORTPOS_IPN_URL=http://localhost:5000/api/v1/payments/portpos/ipn

# Email Configuration (Nodemailer SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=no-reply@nerobecommerce.com

# Redis Configuration (Optional Cache)
REDIS_URL=redis://localhost:6379

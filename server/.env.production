# ==============================================================================
# EASILIA PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Set your production values when deploying to VPS (Ubuntu, Debian), Docker,
# or Cloud Platforms (Render, Railway, DigitalOcean, AWS, etc.).

# ------------------------------------------------------------------------------
# 1. Server & Host Configuration
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production
SITE_NAME=Easilia

# Publicly accessible URL of this backend API (No trailing slash)
# Used for constructing public asset URLs (e.g. uploaded images, payment callbacks)
SERVER_URL=https://api.yourdomain.com

# ------------------------------------------------------------------------------
# 2. CORS & Allowed Frontend Origins
# ------------------------------------------------------------------------------
# Primary frontend domain URL (No trailing slash)
CLIENT_URL=https://yourdomain.com

# Comma-separated list of allowed origins that can make API requests and connect via Socket.IO.
# Supports multiple domains and subdomains (e.g. main site, admin panel, seller dashboard).
# Use '*' to allow all incoming origins (useful during initial staging).
CORS_ORIGIN=https://yourdomain.com,https://admin.yourdomain.com,https://seller.yourdomain.com

# ------------------------------------------------------------------------------
# 3. Database (MongoDB)
# ------------------------------------------------------------------------------
# Connection string for MongoDB Atlas or self-hosted VPS MongoDB
MONGO_URI=mongodb+srv://productionUser:StrongPassword123@cluster0.example.mongodb.net/easilia_db?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 4. JWT Authentication Secrets & Expiry
# ------------------------------------------------------------------------------
# Generate cryptographically secure keys: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_char_secure_random_hex_key_for_access_tokens
JWT_REFRESH_SECRET=replace_with_64_char_secure_random_hex_key_for_refresh_tokens
JWT_ACCESS_EXPIRY=7d
JWT_REFRESH_EXPIRY=15m

# ------------------------------------------------------------------------------
# 5. Google OAuth 2.0
# ------------------------------------------------------------------------------
# Web client ID from Google Cloud Console (Credentials -> OAuth 2.0 Client IDs)
# Make sure your production domain (e.g. https://yourdomain.com) is added to "Authorized JavaScript origins"
GOOGLE_CLIENT_ID=your_production_google_client_id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 6. VPS Media & Local File Upload Configuration
# ------------------------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_MB=15
MAX_VIDEO_SIZE_MB=100
MAX_DOC_SIZE_MB=25

# ------------------------------------------------------------------------------
# 7. Payment Gateway (PortPos)
# ------------------------------------------------------------------------------
PORTPOS_STORE_ID=your_production_portpos_store_id
PORTPOS_STORE_PASSWORD=your_production_portpos_store_password
PORTPOS_IS_LIVE=true
PORTPOS_SUCCESS_URL=https://yourdomain.com/payment/success
PORTPOS_FAIL_URL=https://yourdomain.com/payment/fail
PORTPOS_CANCEL_URL=https://yourdomain.com/payment/cancel
PORTPOS_IPN_URL=https://api.yourdomain.com/api/v1/payments/portpos/ipn

# ------------------------------------------------------------------------------
# 8. Email / SMTP (Nodemailer)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_production_email@gmail.com
SMTP_PASS=your_16_char_google_app_password
EMAIL_FROM=no-reply@yourdomain.com

# ------------------------------------------------------------------------------
# 9. Redis Cache (Optional)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 10. Default Seed Administrator
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ChangeThisSecurePassword2026!
ADMIN_NAME=Super Admin
ADMIN_PHONE=01800000000
